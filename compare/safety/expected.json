  "p08_unbounded_recursion": {
    "note": "Release may never overflow: clang turns f(n + 1) + 1 into a loop with an accumulator, which then runs for about 2^63 steps, well defined but endless; MSVC's build overflows the native stack and aborts. --checked and --debug keep the recursion and abort.",
    "timeout": 10,
    "release": {
      "outcome": [
        "abort",
        "timeout"
      ],
      "contains": [
        "native call stack overflow"
      ]
    },
    "checked": {
      "outcome": "abort",
      "contains": [
        "native call stack overflow"
      ]
    },
    "debug": {
      "outcome": "abort",
      "contains": [
        "native call stack overflow"
      ]
    }
  },
  "p09_use_after_free": {
    "note": "Not caught: a reference to a freed and reused slot of a reusable pool reads the slot's new value (a value of the right type, never memory corruption; spec 5.4). slots handles (stdlib/slots.goose) catch it for handles, not for references.",
