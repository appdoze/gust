// A JSON API in Gust: a product catalog and orders, served over HTTP/1.1,
// with validation errors in FastAPI's shape. Its Go twins are
// examples/api/go/server (net/http) and go/rawserver (the same HTTP as
// here); bench.py drives all three with the same workload.
//
//   gust build examples/api/api.gust -o api.exe
//   api.exe [port] [--workers N] [--thread-per-connection] [--crash-route]
//                                    (port 8080 by default; Ctrl-C stops it gracefully)
//
//   GET  /health                     {"status":"ok"}
//   GET  /v1/items[?repeat=N]        {"items":[...]}, the catalog N times (1-1000), built whole
//   GET  /v1/items/export?repeat=N   the same, N up to 1,000,000, streamed as the client reads
//   GET  /v1/items/{id}              an item, or 404
//   POST /v1/orders                  {"item_id":1,"quantity":2,"note":"..."} -> 201, or 422
//
// How the parts fit Gust's model:
// - Networking. The standard library's net (stdlib/net.goose) holds the
//   sockets, the poller and the event loop; http.gust is a protocol over
//   it, and this file the routes.
// - Concurrency. By default a pool of workers, one per hardware thread
//   (--workers), each an event loop over the connections it accepts;
//   --thread-per-connection gives each connection a thread instead, whose
//   handler may block. Gust threads share no memory, so a handler cannot
//   race another. What they all read is the catalog, a `const` that is
//   static data: shared as it is, never copied.
// - Memory. Buffers and responses live on data stacks, released when their
//   scope ends, and in the loop's buffers while a request is partly read or
//   a response partly sent: no heap allocation per request, and no
//   collector. A response past what is built whole (http.gust's
//   MAX_RESPONSE) is streamed, so its size costs no memory.
// - Identity without shared state. An order's id is its connection's
//   number and its count on that connection, unique with no counter shared
//   between threads.
// - Failure. Workers are contained (§11.2): an abort in a handler (an
//   index out of range, say) ends that worker and no more, the runtime
//   closes the sockets it held, and its supervisor starts another. In the
//   pool that ends every connection of the aborting worker, about 1/N of
//   them; with a thread per connection it ends that connection only.
//   Neither contains what the runtime does not: a data stack overrunning
//   its reservation, native stack exhaustion, exit(), or a fault in C code
//   end the process.
// - Shutdown. Ctrl-C (or SIGTERM) sets a flag; the server stops accepting,
//   every connection finishes the request it is serving and closes, and
//   the server reports what it served once they are done, or after
//   SHUTDOWN_GRACE_S seconds.
import std;
import os;
import json;
import net;
import http;
import jsonx;

// With a thread per connection, each connection takes 8 data-stack regions of address space (6 for its
// thread, 2 for its supervisor; `gust build --stacks` reports them), and
// the default 2 GB per region leaves room for about 2,000: past this limit
// a connection is answered 503 rather than given a thread the runtime may
// not have. `--stack-reserve 256M` makes room for eight times as many.
const MAX_CONNECTIONS = 1024;
// The pool's limit over all its workers: a connection there costs a record
// of the loop's and, while it has a request under way, a buffer.
const MAX_LOOP_CONNECTIONS = 65536;
const SHUTDOWN_GRACE_S = 10.0;
// The longest the acceptor waits, so it looks at the stop flag.
const POLL_MS = 100;

struct Item { id: i64, name: Str64, price_cents: i64, rating: f64, in_stock: bool }
fn encode_value(out: u8[>..]&, v: Item) { encode_fields(out, v); }

struct OrderIn { item_id: i64, quantity: i64, note: Str64 }

struct Order { id: i64, item_id: i64, quantity: i64, total_cents: i64, note: Str64 }
fn encode_value(out: u8[>..]&, v: Order) { encode_fields(out, v); }

const CATALOG = [
    Item { 1, "Espresso", 250, 4.6, true },
    Item { 2, "Cappuccino", 380, 4.4, true },
    Item { 3, "Flat white", 390, 4.7, true },
    Item { 4, "Cold brew", 420, 4.1, false },
    Item { 5, "Croissant", 310, 4.5, true },
    Item { 6, "Banana bread", 295, 3.9, true },
    Item { 7, "Oat milk latte", 450, 4.3, true },
    Item { 8, "Matcha", 470, 4.0, false },
];
const MAX_REPEAT = 1000;
const MAX_EXPORT_REPEAT = 1000000;
// More than any item's JSON takes: a name is at most 64 bytes, each
// escaped to at most 6.
const ITEM_JSON_MAX = 512;

// One connection's state, which only its thread sees: what it has ordered,
// and the export it is streaming, as items from export_at to export_end.
struct Session { conn: i64, orders: i64 = 0, crash_route: bool = false, export_at: i64 = 0, export_end: i64 = 0 }

fn not_found(res: Response&, out: u8[>..]&) {
    res.status = 404;
    out.append("{\"detail\":\"Not Found\"}");
}

fn not_allowed(res: Response&, out: u8[>..]&, allow: const u8[:]) {
    res.status = 405;
    res.allow = allow;
    out.append("{\"detail\":\"Method Not Allowed\"}");
}

// The value of name=<integer> in a query, or def where it has none; false
// when it has one that is not an integer.
fn query_int(query: const u8[:], name: const u8[:], def: i64) -> i64, bool {
    var start = 0;
    for i in query.len + 1 {
        if i == query.len || query[i] == '&' {
            let part = query[start..i];
            if part.len > name.len && starts_with(part, name) && part[name.len] == '=' {
                let v, ok = parse_int(part[name.len + 1..]);
                return v, ok;
            }
            start = i + 1;
        }
    }
    return def, true;
}

// ?repeat=N within 1..most, or a 422 naming it.
fn repeat_of(req: Request&, res: Response&, out: u8[>..]&, most: i64) -> i64 {
    let n, ok = query_int(req.query, "repeat", 1);
    if ok && n >= 1 && n <= most { return n; }
    var p = Problems { .. };
    problem_in(p, out, "query", "repeat", str("Input should be an integer from 1 to ", most), "value_error");
    finish_problems(p, out);
    res.status = 422;
    return 0;
}

// The catalog's item k (from 0), numbered k + 1: the catalog over and over.
fn item_at(k: i64) -> Item {
    var it = CATALOG[k % CATALOG.len];
    it.id = k + 1;
    return it;
}

// The routes. A path that names a resource but not this method is a 405
// naming the ones it has, as Go 1.22's ServeMux answers.
fn handle(s: Session&, req: Request&, res: Response&, out: u8[>..]&) {
    let path = req.path;
    if path == "/health" {
        if req.method != "GET" { not_allowed(res, out, "GET"); return; }
        out.append("{\"status\":\"ok\"}");
        return;
    }
    if path == "/v1/items" {
        if req.method != "GET" { not_allowed(res, out, "GET"); return; }
        let n = repeat_of(req, res, out, MAX_REPEAT);
        if n == 0 { return; }
        out.append("{\"items\":[");
        for k in n * CATALOG.len {
            if k > 0 { out.push(','); }
            encode_value(out, item_at(k));
        }
        out.append("]}");
        return;
    }
    if path == "/v1/items/export" {
        if req.method != "GET" { not_allowed(res, out, "GET"); return; }
        let n = repeat_of(req, res, out, MAX_EXPORT_REPEAT);
        if n == 0 { return; }
        out.append("{\"items\":[");
        s.export_at = 0;
        s.export_end = n * CATALOG.len;
        res.stream = true;
        return;
    }
    if starts_with(path, "/v1/items/") {
        if req.method != "GET" { not_allowed(res, out, "GET"); return; }
        let id, ok = parse_int(path[10..]);
        if !ok || id < 1 || id > CATALOG.len { not_found(res, out); return; }
        encode_value(out, CATALOG[id - 1]);
        return;
    }
    if path == "/v1/orders" {
        if req.method != "POST" { not_allowed(res, out, "POST"); return; }
        create_order(s, req, res, out);
        return;
    }
    if path == "/debug/crash" && s.crash_route {
        // A deliberate bug, to show what containment does with one: an index
        // past the end aborts this connection's thread and nothing else.
        let i = CATALOG.len + req.body.len;
        encode_value(out, CATALOG[i]);
        return;
    }
    not_found(res, out);
}

// The export's next items, within limit: true once its last byte is out.
fn export_more(s: Session&, out: u8[>..]&, limit: i64) -> bool {
    let start = out.len;
    while s.export_at < s.export_end && out.len - start + ITEM_JSON_MAX <= limit {
        if s.export_at > 0 { out.push(','); }
        encode_value(out, item_at(s.export_at));
        s.export_at += 1;
    }
    if s.export_at < s.export_end { return false; }
    out.append("]}");
    return true;
}

fn create_order(s: Session&, req: Request&, res: Response&, out: u8[>..]&) {
    var r = json::reader(req.body);
    var o = OrderIn { item_id: 0, quantity: 0, note: "" };
    let d = decode_fields(r, o);
    json::finish(r);
    var p = Problems { .. };
    if r.error.len > 0 {
        if d.failed >= 0 { problem(p, out, field_name(o, d.failed), r.error, "value_error"); }
        else { problem(p, out, "", json::message(r), "json_invalid"); }
    } else {
        if !gave(d, o, "item_id") { problem(p, out, "item_id", "Field required", "missing"); }
        else if o.item_id < 1 || o.item_id > CATALOG.len {
            problem(p, out, "item_id", "No item has this id", "value_error");
        }
        if !gave(d, o, "quantity") { problem(p, out, "quantity", "Field required", "missing"); }
        else if o.quantity < 1 { problem(p, out, "quantity", "Input should be greater than or equal to 1", "greater_than_equal"); }
        else if o.quantity > 100 { problem(p, out, "quantity", "Input should be less than or equal to 100", "less_than_equal"); }
    }
    if p.count > 0 {
        finish_problems(p, out);
        res.status = 422;
        return;
    }
    let item = CATALOG[o.item_id - 1];
    if !item.in_stock {
        res.status = 409;
        out.append("{\"detail\":\"Out of stock\"}");
        return;
    }
    s.orders += 1;
    let order = Order { id: (s.conn << 20) | s.orders, item_id: o.item_id, quantity: o.quantity,
                        total_cents: item.price_cents * o.quantity, note: o.note };
    res.status = 201;
    encode_value(out, order);
}

// --- one thread per connection (--thread-per-connection) ----------------------

// A connection, adopted by a thread of its own and served there; what it
// served goes back to main as one Counts.
thread_fn connection(d: net::Detached, conn: i64, crash_route: bool) {
    let p, ps = net::poller();
    let c, status = net::adopt(p, d);
    if ps != 0 || status != 0 { return; }
    qput(serve(net::Listener { .. }, p, c, Session { conn: conn, crash_route: crash_route, .. }, 1, conn, 1,
               handle, export_more));
}

// How a connection ended, from its supervisor.
struct Ended { conn: i64, aborted: bool, message: u8[] }

// Runs one connection contained and waits for it. When it ends, by
// returning or by an abort, the runtime closes its socket.
thread_fn supervise(d: net::Detached, conn: i64, crash_route: bool) {
    let id = thread_spawn_contained(connection, d, conn, crash_route);
    var message: u8[>..] = [];
    let ok = thread_wait(id, message);
    qput(Ended { conn: conn, aborted: !ok, message: copy(message) });
}

struct Totals { connections: i64 = 0, live: i64 = 0, aborted: i64 = 0, busy: i64 = 0 }

fn ended(t: Totals&, e: const Ended&) {
    t.live -= 1;
    if e.aborted {
        t.aborted += 1;
        write_stderr(str("connection ", e.conn, " aborted: ", e.message, "\n"));
    }
}

fn add(sum: Counts&, c: Counts) {
    sum.requests += c.requests;
    sum.ok += c.ok;
    sum.client_errors += c.client_errors;
    sum.server_errors += c.server_errors;
    sum.refused += c.refused;
    sum.connections += c.connections;
    sum.busy += c.busy;
    sum.dropped += c.dropped;
}

// Accepts on this thread, and hands each connection to a thread of its own.
fn serve_threads(listener: net::Listener, crash_route: bool, t: Totals&) {
    let p, ps = net::poller();
    if ps != 0 || net::watch(p, listener) != 0 { abort("cannot wait on the listener"); }
    var busy: u8[>..] = [];
    format_refusal(busy, 503);
    var hs: i64[..1] = [0];
    var evs: i64[..1] = [0];
    while !net::stop_requested() {
        if net::wait(p, POLL_MS, hs, evs) < 0 { break; }
        loop {
            let c, status = net::accept(p, listener);
            if status != 0 { break; }
            t.connections += 1;
            if t.live >= MAX_CONNECTIONS {
                // Over the limit: refused here, without a thread.
                net::send(p, c, busy);
                net::close(p, c);
                t.busy += 1;
                continue;
            }
            let d, ds = net::detach(p, c);
            if ds != 0 { net::close(p, c); continue; }
            thread_spawn(supervise, d, t.connections, crash_route);
            t.live += 1;
        }
        loop {
            let e, got = qpoll<Ended>();
            if !got { break; }
            ended(t, e);
        }
    }
    net::close(p);

    // Graceful shutdown: no new connections; each open one finishes the
    // request it is on, answers it with Connection: close, and ends.
    print("stopping: waiting for ", t.live, " connection(s)");
    let deadline = clock() + SHUTDOWN_GRACE_S;
    while t.live > 0 && clock() < deadline {
        let e, got = qget<Ended>(100);
        if got { ended(t, e); }
    }
    if t.live > 0 { print(t.live, " connection(s) still open at the deadline"); }
}

// --- a worker pool, each worker an event loop (the default) -------------------

// One worker: an event loop over the connections it accepts. Connection
// numbers are slot + workers * (round << 24) + workers * k, so no two
// workers, nor two rounds of one, give out the same.
thread_fn pool_worker(listener: net::Listener, slot: i64, workers: i64, round: i64, crash_route: bool) {
    let p, ps = net::poller();
    if ps != 0 { abort("cannot make a poller"); }
    let proto = Session { conn: 0, crash_route: crash_route, .. };
    let first = slot + workers * (round << 24);
    qput(serve(listener, p, net::Conn { .. }, proto, max(1, MAX_LOOP_CONNECTIONS / workers), first, workers,
               handle, export_more));
}

// A worker that aborted, and its message.
struct Restarted { slot: i64, message: u8[] }
struct PoolDone { slot: i64 }

// Runs one worker contained, and starts another when one aborts: the
// runtime has closed the poller and every connection the aborted one held.
thread_fn pool_supervisor(listener: net::Listener, slot: i64, workers: i64, crash_route: bool) {
    var round = 0;
    loop {
        let id = thread_spawn_contained(pool_worker, listener, slot, workers, round, crash_route);
        var message: u8[>..] = [];
        let ok = thread_wait(id, message);
        if ok || net::stop_requested() { break; }
        qput(Restarted { slot: slot, message: copy(message) });
        round += 1;
    }
    qput(PoolDone { slot: slot });
}

fn serve_pool(listener: net::Listener, workers: i64, crash_route: bool, t: Totals&) {
    for w in workers { thread_spawn(pool_supervisor, listener, w, workers, crash_route); }
    var running = workers;
    var stopping = false;
    var deadline = 0.0;
    while running > 0 {
        let r, got = qget<Restarted>(100);
        if got {
            t.aborted += 1;
            write_stderr(str("worker ", r.slot, " aborted, its connections closed, and restarted: ",
                             r.message, "\n"));
        }
        loop {
            let d, done = qpoll<PoolDone>();
            if !done { break; }
            running -= 1;
        }
        if !stopping && net::stop_requested() {
            stopping = true;
            deadline = clock() + SHUTDOWN_GRACE_S + 2.0;
            print("stopping: waiting for ", running, " worker(s)");
        }
        if stopping && clock() > deadline {
            print(running, " worker(s) still running at the deadline");
            break;
        }
    }
}

fn usage(what: const u8[:]) {
    abort(str("usage: api [port] [--workers N] [--thread-per-connection] [--crash-route]; ", what));
}

fn main() {
    let a = args();
    var port = 8080;
    var crash_route = false;
    var threads_mode = false;
    var workers = max(1, min(hardware_threads(), 64));
    var i = 1;
    while i < a.len {
        if a[i] == "--crash-route" { crash_route = true; }
        else if a[i] == "--thread-per-connection" { threads_mode = true; }
        else if a[i] == "--workers" {
            i++;
            if i == a.len { usage("--workers needs a number"); }
            let n, ok = parse_int(a[i]);
            if !ok || n < 1 || n > 256 { usage(str("bad worker count ", a[i])); }
            workers = n;
        } else {
            let n, ok = parse_int(a[i]);
            if !ok || n < 1 || n > 65535 { usage(str("got ", a[i])); }
            port = n;
        }
        i++;
    }
    net::catch_signals();
    let listener, status = net::listen(port, 1024);
    if status != 0 { abort(str("cannot listen on port ", port, ": ", net::error_text(status))); }
    if threads_mode { print("listening on :", port, ", a thread per connection"); }
    else { print("listening on :", port, ", ", workers, " worker(s)"); }

    var t = Totals { .. };
    if threads_mode { serve_threads(listener, crash_route, t); }
    else { serve_pool(listener, workers, crash_route, t); }
    net::close(listener);

    var sum = Counts { .. };
    loop {
        let c, got = qpoll<Counts>();
        if !got { break; }
        add(sum, c);
    }
    let connections = if threads_mode { t.connections } else { sum.connections };
    print("served ", sum.requests, " request(s) on ", connections, " connection(s): ",
          sum.ok, " ok, ", sum.client_errors, " client errors, ", sum.server_errors, " server errors, ",
          sum.refused, " refused, ", t.busy + sum.busy, " turned away busy, ", sum.dropped, " dropped, ",
          t.aborted, " aborted");
}
