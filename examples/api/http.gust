// HTTP/1.1, the server side of what a JSON API needs, as a protocol over
// the standard library's event loop (net::serve, stdlib/net.goose):
// requests parsed in place, keep-alive and pipelining, Content-Length
// bodies, responses of any size, limits on what a client may send, and the
// error responses a server owes a client that breaks them. Not here:
// chunked request bodies (refused with 501), TLS (terminated in front, as
// many Go services do behind a load balancer) and HTTP/2.
//
// A handler H(state, req, res, body) writes a whole response body, which
// may be up to MAX_RESPONSE bytes. One that sets res.stream answers with
// what it wrote and then what G(state, out, limit) -> done appends, called
// as the client takes it: a response of any size in bounded memory, sent
// chunked (to an HTTP/1.0 client, until the connection closes).
//
// serve runs the protocol either way api.gust serves: over a listener, one
// worker of a pool, multiplexing its connections, where handlers must not
// block, since the worker's thread is all of its connections'; or over one
// connection on a thread of its own, where they may.
//
// Memory: requests are read into the loop's buffers and parsed in place;
// responses are built on data stacks and released at the end of their
// scope, or queued in the loop's chunks while the client has not taken
// them. Serving a request allocates nothing from the heap, and a
// connection's memory is bounded by the limits below.
import std;
import net;

// What a client may send, as Go's http.Server has MaxHeaderBytes and a
// handler http.MaxBytesReader: the request line and headers, the body, and
// how long a connection may sit idle between requests.
const MAX_HEAD = 8192;
const MAX_BODY = 8192;
const IDLE_MS = 5000;
const REQUEST_MS = 5000;         // from a request's first byte to its last (Go's ReadHeaderTimeout)
const SEND_TIMEOUT_MS = 5000;    // output waiting and none of it taken
const GRACE_MS = 10000;          // after a stop, for requests in flight
// A response built whole: past it, a handler streams (res.stream).
const MAX_RESPONSE = 1048576;
// What G produces at once: a stream holds no more than this, past what the
// socket's buffers do.
const STREAM_PIECE = 65536;
// All of a worker's responses waiting for their clients. The loop keeps
// what it has used of this until the worker ends.
const MAX_QUEUED = 16777216;

// A request, every slice of it a view of the loop's input buffer.
struct Request {
    method: const u8[:],
    path: const u8[:],           // the target up to its '?'
    query: const u8[:],          // after the '?', or empty
    body: const u8[:],
    keep_alive: bool,
    http11: bool,                // HTTP/1.1, which can take a chunked response
    // The loop's: when the request should be done (0.0 for no limit), and
    // whether the server is stopping, for a handler doing long work to cut
    // it short (net::Ctl).
    deadline: f64 = 0.0,
    stopping: bool = false,
}

// What a handler sets besides the body it writes.
struct Response {
    status: i64 = 200,
    allow: const u8[:] = "",     // the methods a 405 names
    close: bool = false,         // end the connection after this response
    stream: bool = false,        // the body goes on with what G produces
}

// What a connection served, for the server's totals.
struct Counts { requests: i64 = 0, ok: i64 = 0, client_errors: i64 = 0, server_errors: i64 = 0, refused: i64 = 0,
               connections: i64 = 0, busy: i64 = 0, dropped: i64 = 0 }

fn reason(status: i64) -> const u8[:] {
    return match status {
        200 => "OK",
        201 => "Created",
        400 => "Bad Request",
        404 => "Not Found",
        405 => "Method Not Allowed",
        408 => "Request Timeout",
        409 => "Conflict",
        413 => "Content Too Large",
        422 => "Unprocessable Content",
        431 => "Request Header Fields Too Large",
        500 => "Internal Server Error",
        501 => "Not Implemented",
        503 => "Service Unavailable",
        _ => "Unknown",
    };
}

fn lower(c: u8) -> u8 { if c >= 'A' && c <= 'Z' { c + 32 } else { c } }

// Whether s equals word, ignoring ASCII case; word is lower case.
fn equal_fold(s: const u8[:], word: const u8[:]) -> bool {
    if s.len != word.len { return false; }
    for i in s.len {
        if lower(s[i]) != word[i] { return false; }
    }
    return true;
}

// Whether a comma-separated header value holds token, ignoring case
// (`Connection: keep-alive, Upgrade`).
fn has_token(value: const u8[:], token: const u8[:]) -> bool {
    var start = 0;
    for i in value.len + 1 {
        if i == value.len || value[i] == ',' {
            if equal_fold(trim(value[start..i]), token) { return true; }
            start = i + 1;
        }
    }
    return false;
}

// Where the head ends (just past its blank line) in b, searching from
// `from`; -1 if it is not there yet.
fn head_end(b: const u8[:], from: i64) -> i64 {
    var i = max(from, 3);
    while i < b.len {
        if b[i] == '\n' && b[i - 1] == '\r' && b[i - 2] == '\n' && b[i - 3] == '\r' { return i + 1; }
        i++;
    }
    return -1;
}

// A Content-Length value: digits only, at most MAX_BODY; -1 if malformed,
// MAX_BODY + 1 if larger.
fn content_length(v: const u8[:]) -> i64 {
    if v.len == 0 { return -1; }
    var n = 0;
    for c in v {
        if c < '0' || c > '9' { return -1; }
        n = min(n * 10 + (c - '0'), MAX_BODY + 1);
    }
    return n;
}

// The request in head (its request line and headers, through the blank
// line), with its body still empty, and the body's length; or a status to
// refuse it with (0 when it is fine).
fn parse_head(head: const u8[:]) -> Request, i64, i64 {
    var req = Request { method: "", path: "", query: "", body: "", keep_alive: false, http11: false };
    // The request line: METHOD SP target SP HTTP/1.x CRLF.
    var eol = 0;
    while eol < head.len && head[eol] != '\r' { eol++; }
    let line = head[0..eol];
    var sp1 = 0;
    while sp1 < line.len && line[sp1] != ' ' { sp1++; }
    var sp2 = sp1 + 1;
    while sp2 < line.len && line[sp2] != ' ' { sp2++; }
    if sp1 == 0 || sp2 >= line.len || sp2 == sp1 + 1 { return req, 0, 400; }
    req.method = line[0..sp1];
    let target = line[sp1 + 1..sp2];
    let version = line[sp2 + 1..line.len];
    if target[0] != '/' { return req, 0, 400; }
    var q = 0;
    while q < target.len && target[q] != '?' { q++; }
    req.path = target[0..q];
    req.query = if q < target.len { target[q + 1..target.len] } else { "" };
    if version == "HTTP/1.1" {
        req.keep_alive = true;
        req.http11 = true;
    } else if version != "HTTP/1.0" {
        return req, 0, 400;
    }

    var length = 0;
    var seen_length = false;
    var hosts = 0;
    var at = eol + 2;
    while at < head.len - 2 {
        var end = at;
        while end < head.len && head[end] != '\r' { end++; }
        let h = head[at..end];
        at = end + 2;
        var colon = 0;
        while colon < h.len && h[colon] != ':' { colon++; }
        if colon == 0 || colon == h.len { return req, 0, 400; }
        let name = h[0..colon];
        let value = trim(h[colon + 1..h.len]);
        if equal_fold(name, "content-length") {
            let n = content_length(value);
            if n < 0 || (seen_length && n != length) { return req, 0, 400; }
            length = n;
            seen_length = true;
        } else if equal_fold(name, "transfer-encoding") {
            return req, 0, 501;
        } else if equal_fold(name, "connection") {
            if has_token(value, "close") { req.keep_alive = false; }
            else if has_token(value, "keep-alive") { req.keep_alive = true; }
        } else if equal_fold(name, "host") {
            hosts++;
        }
    }
    // RFC 9112 §3.2: an HTTP/1.1 request has exactly one Host header.
    if hosts > 1 || (hosts == 0 && req.http11) { return req, 0, 400; }
    if length > MAX_BODY { return req, length, 413; }
    return req, length, 0;
}

// The status line and the headers, through the blank line.
fn format_head(out: u8[>..]&, res: Response&, keep_alive: bool) {
    format(out, "HTTP/1.1 ", res.status, " ", reason(res.status), "\r\n");
    out.append("Content-Type: application/json\r\n");
    if res.allow.len > 0 { format(out, "Allow: ", res.allow, "\r\n"); }
    if !keep_alive { out.append("Connection: close\r\n"); }
}

// A whole response: the head, its length, and the body.
fn format_response(out: u8[>..]&, res: Response&, body: const u8[:], keep_alive: bool) {
    format_head(out, res, keep_alive);
    format(out, "Content-Length: ", body.len, "\r\n\r\n");
    out.append(body);
}

// A refusal's whole response, {"detail":"<reason>"}, after which the
// connection ends.
fn format_refusal(out: u8[>..]&, status: i64) {
    var res = Response { status: status, .. };
    var body: u8[>..] = [];
    format(body, "{\"detail\":\"", reason(status), "\"}");
    format_response(out, res, body, false);
}

fn count(counts: Counts&, status: i64) {
    counts.requests += 1;
    if status < 400 { counts.ok += 1; }
    else if status < 500 { counts.client_errors += 1; }
    else { counts.server_errors += 1; }
}

// A connection's protocol state: the application's, and how the response
// being streamed is framed.
struct Conn<S> {
    app: S,
    chunked: bool = false,       // chunks; else to the end of the connection (HTTP/1.0)
    keep: bool = false,          // the connection stays open after it
}

// The hex digits a chunk's size takes; a size is written with leading zeros.
const SIZE_DIGITS = 8;

// Serves HTTP until the server stops, on the connections of listener (none:
// net::Listener { }) and the one in first (none: net::Conn { }), already in
// poller, at most max_conns at once over every worker serving listener;
// with no listener, until that connection ends. state is a copy of proto for each connection, of any
// fixed-size type with a `conn` field, which is set to the connection's
// number: first_id, first_id + id_step, ...
fn serve<H, G, S>(listener: net::Listener, poller: net::Poller, first: net::Conn, proto: S,
                  max_conns: i64, first_id: i64, id_step: i64) -> Counts {
    var counts = Counts { .. };

    // What the loop sends by itself: 503 past max_conns, 408 to a request
    // that is not whole within REQUEST_MS.
    var busy: u8[>..] = [];
    format_refusal(busy, 503);
    var timeout: u8[>..] = [];
    format_refusal(timeout, 408);

    fn refuse(out: u8[>..]&, ctl: net::Ctl&, status: i64) {
        format_refusal(out, status);
        ctl.close = true;
        counts.refused += 1;
    }

    // The next request in input, answered: the bytes it took (all of them
    // for a refusal, which ends the connection), or 0 while it is not
    // whole.
    fn on_input(c: Conn<S>&, ctl: net::Ctl&, input: const u8[:], out: u8[>..]&) -> i64 {
        let end = head_end(input, 0);
        if end < 0 {
            if input.len >= MAX_HEAD { refuse(out, ctl, 431); return input.len; }
            return 0;
        }
        if end > MAX_HEAD { refuse(out, ctl, 431); return input.len; }
        var req, length, status = parse_head(input[0..end]);
        if status != 0 { refuse(out, ctl, status); return input.len; }
        if input.len < end + length { return 0; }
        let done = end + length;
        req.body = input[end..done];
        req.deadline = ctl.deadline;
        req.stopping = ctl.stopping;
        c.app.conn = ctl.conn;
        var res = Response { .. };
        var body: u8[>..] = [];
        H(c.app, req, res, body);
        let keep = req.keep_alive && !res.close && !net::stop_requested();
        if res.stream {
            count(counts, res.status);
            format_head(out, res, keep && req.http11);
            c.chunked = req.http11;
            c.keep = keep && req.http11;
            if c.chunked { out.append("Transfer-Encoding: chunked\r\n"); }
            out.append("\r\n");
            if body.len > 0 {
                if c.chunked { format(out, hex(body.len), "\r\n"); }
                out.append(body);
                if c.chunked { out.append("\r\n"); }
            }
            ctl.produce = true;
            return done;
        }
        // A body past MAX_RESPONSE, or more than the worker has room to
        // queue now, is not sent: a 500 for a handler that should have
        // streamed, a 503 for a worker out of output memory.
        if body.len > MAX_RESPONSE || body.len + 512 > ctl.room {
            res = Response { status: if body.len > MAX_RESPONSE { 500 } else { 503 }, .. };
            body.clear();
            format(body, "{\"detail\":\"", reason(res.status), "\"}");
        }
        count(counts, res.status);
        format_response(out, res, body, keep);
        if !keep { ctl.close = true; }
        return done;
    }

    // The streamed body's next part, within room: a chunk, then the last
    // chunk once G is done.
    fn on_room(c: Conn<S>&, ctl: net::Ctl&, out: u8[>..]&, room_now: i64) {
        let room = min(room_now, STREAM_PIECE);
        if !c.chunked {
            if G(c.app, out, room) {
                ctl.produce = false;
                ctl.close = true;
            }
            return;
        }
        // The size, written once G has appended what it will.
        let framing = SIZE_DIGITS + 4 + 5;    // its size line and CRLF; the last chunk
        out.append("00000000\r\n");
        let start = out.len;
        let finished = G(c.app, out, room - framing);
        let n = out.len - start;
        if n > 0 {
            var size = n;
            for k in SIZE_DIGITS {
                out[start - 3 - k] = "0123456789abcdef"[size & 15];
                size >>= 4;
            }
            out.append("\r\n");
        } else {
            out.resize(start - SIZE_DIGITS - 2, 0);
        }
        if finished {
            out.append("0\r\n\r\n");
            ctl.produce = false;
            if !c.keep { ctl.close = true; }
        }
    }

    let limits = net::Limits { max_conns: max_conns, pool_conns: max_conns, in_size: MAX_HEAD + MAX_BODY,
                               out_queue: MAX_RESPONSE + 65536, out_total: MAX_QUEUED, idle_ms: IDLE_MS,
                               read_ms: REQUEST_MS, write_ms: SEND_TIMEOUT_MS, grace_ms: GRACE_MS, .. };
    let stats = net::serve(listener, poller, first, Conn { app: proto, .. }, limits,
                           net::Replies { busy: busy, timeout: timeout }, first_id, id_step,
                           on_input, on_room);
    counts.connections += stats.accepted;
    counts.busy += stats.busy;
    counts.refused += stats.read_timeouts;
    counts.dropped += stats.overflows + stats.write_timeouts + stats.errors + stats.protocol;
    return counts;
}

// n in lower-case hex.
fn hex(n: i64) -> u8[>..] {
    var digits: u8[>..] = [];
    var v = n;
    loop {
        digits.push("0123456789abcdef"[v & 15]);
        v >>= 4;
        if v == 0 { break; }
    }
    var out: u8[>..] = [];
    for k in digits.len { out.push(digits[digits.len - 1 - k]); }
    return out;
}
